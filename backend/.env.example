# 应用基础配置（开发默认值，均非必填）
APP_NAME=life-buy-agent-api
APP_ENV=development
LOG_LEVEL=INFO

# 数据库配置统一放在仓库根目录 .env；此处仅保留兼容提示，不要重复填写密码。
# 显式 DATABASE_URL 环境变量仍可覆盖根目录配置，用于 CI 和隔离验收。

# 本地 HTTP 开发配置；生产环境必须 SESSION_COOKIE_SECURE=true 并使用 HTTPS
SESSION_COOKIE_NAME=life_agent_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_MAX_AGE_SECONDS=86400
# JSON 数组，只允许实际部署的同源网页来源
TRUSTED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# DeepSeek 模型连通检查；API Key 只填写在本地 .env，不要提交
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# MCP 服务映射使用 JSON；只从受信后端配置读取，不接受网页提交任意地址
MCP_SERVICES={"shopping":{"url":"http://127.0.0.1:8101/mcp","transport":"streamable_http","timeout_seconds":10,"enabled":true}}

# Worker租约和轮询；购物模型/MCP调用期间会自动续租
RUN_WORKER_LEASE_SECONDS=30
RUN_WORKER_POLL_SECONDS=1
RUN_WORKER_MAX_ATTEMPTS=3
RUN_EVENTS_POLL_SECONDS=1
RUN_EVENTS_HEARTBEAT_SECONDS=15

# 应用启动不依赖模型 API Key、PostgreSQL 或 Java 服务。
