# 项目本地开发配置。复制为仓库根目录 .env；该文件已被 Git 忽略。
# 不要把真实密码、API Key 或其他密钥提交到仓库。

# 项目专用 PostgreSQL（默认 Compose 仅启动此服务）
POSTGRES_DB=life_buy_agent
POSTGRES_USER=life_buy
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=55432
POSTGRES_VOLUME_NAME=life-buy-agent-postgres-data
DATABASE_URL=postgresql+psycopg://life_buy:postgres@127.0.0.1:55432/life_buy_agent

# 可选 profile=optional 的本地服务；当前后端不依赖它们
MYSQL_DATABASE=life_buy_agent
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
MYSQL_VOLUME_NAME=life-buy-agent-mysql-data
REDIS_PORT=6379
REDIS_VOLUME_NAME=life-buy-agent-redis-data
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_VOLUME_NAME=life-buy-agent-minio-data

# DeepSeek 和 shopping-mcp；LLM_API_KEY 只填写在本机 .env
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
MCP_SERVICES={"shopping":{"url":"http://127.0.0.1:8101/mcp","transport":"streamable_http","timeout_seconds":10,"enabled":true}}
