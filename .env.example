# 项目本地开发配置。复制为仓库根目录 .env；该文件已被 Git 忽略。
# 不要把真实密码、API Key 或其他密钥提交到仓库。
# 后端、Worker、Alembic 只读取仓库根目录 .env，不读取 backend/.env。

# 应用基础配置
APP_NAME=life-buy-agent-api
APP_ENV=development
LOG_LEVEL=INFO

# 项目专用 PostgreSQL（默认 Compose 仅启动此服务）
POSTGRES_DB=life_buy_agent
POSTGRES_USER=life_buy
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=55432
POSTGRES_VOLUME_NAME=life-buy-agent-postgres-data
DATABASE_URL=postgresql+psycopg://life_buy:postgres@127.0.0.1:55432/life_buy_agent

# 可选 profile=optional 的本地服务；当前后端不依赖它们
MYSQL_DATABASE=life_buy_agent
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
MYSQL_VOLUME_NAME=life-buy-agent-mysql-data
REDIS_PORT=6379
REDIS_VOLUME_NAME=life-buy-agent-redis-data
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_VOLUME_NAME=life-buy-agent-minio-data

# 本地 HTTP 开发配置；生产环境必须 SESSION_COOKIE_SECURE=true 并使用 HTTPS
SESSION_COOKIE_NAME=life_agent_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_MAX_AGE_SECONDS=86400
# JSON 数组，只允许实际部署的同源网页来源
TRUSTED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# DeepSeek；API Key 只填写在本机 .env，不要提交
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Mem0 OSS 长期偏好记忆。启用前需安装依赖、下载 Embedding 模型并确保 PostgreSQL
# 已启用 pgvector；DeepSeek Key 复用上方配置，不要重复填写或提交。
MEM0_ENABLED=false
MEM0_COLLECTION=life_agent_preferences
MEM0_EMBEDDER_MODEL=BAAI/bge-m3
MEM0_EMBEDDING_DIMENSIONS=1024
MEM0_HISTORY_DB_PATH=backend/data/mem0_history.db
MEM0_RECALL_LIMIT=4

# shopping-mcp 使用 JSON 配置；高德地图 MCP 使用下方独立变量。
MCP_SERVICES={"shopping":{"url":"http://127.0.0.1:8101/mcp","transport":"streamable_http","timeout_seconds":10,"enabled":true}}
MAP_MCP_URL=https://mcp.amap.com/mcp
MAP_MCP_KEY=
MAP_MCP_TIMEOUT_SECONDS=20
MAP_MCP_ENABLED=false
# 真实握手后以 list_tools 返回的关键词搜索工具名为准
MAP_MCP_TOOL_NAME=maps_text_search
MAP_MCP_NEARBY_TOOL_NAME=maps_around_search
MAP_MCP_GEOCODE_TOOL_NAME=maps_geo
MAP_MCP_WEATHER_TOOL_NAME=maps_weather
# 地址周边查询未指定半径时使用的后端默认值（米），并非用户给出的距离。
MAP_MCP_NEARBY_RADIUS_METERS=1000

# Tavily 公开网页搜索 MCP；仅填写本地 Key 后再启用
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_MCP_KEY=
TAVILY_MCP_TIMEOUT_SECONDS=30
TAVILY_MCP_ENABLED=false
TAVILY_MCP_TOOL_NAME=tavily_search

# Worker 租约、轮询与 SSE；购物模型/MCP 调用期间会自动续租
RUN_WORKER_LEASE_SECONDS=30
RUN_WORKER_POLL_SECONDS=1
RUN_WORKER_MAX_ATTEMPTS=3
RUN_EVENTS_POLL_SECONDS=1
RUN_EVENTS_HEARTBEAT_SECONDS=15

# 对话短期上下文与执行预算（可选覆盖）
CONVERSATION_CONTEXT_MAX_MESSAGES=12
CONVERSATION_CONTEXT_MAX_CHARACTERS=12000
SHOPPING_AGENT_TOTAL_TIMEOUT_SECONDS=180

# 应用启动不依赖模型 API Key、PostgreSQL 或 Java 服务。
