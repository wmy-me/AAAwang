# 本地开发专用的 PostgreSQL 配置模板。
# 复制为 infra/.env 后使用；该文件中的示例密码仅用于本机开发，不适用于生产。

POSTGRES_DB=life_buy_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=life-buy-agent-postgres-data

MYSQL_DATABASE=life_buy_agent
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
MYSQL_VOLUME_NAME=life-buy-agent-mysql-data

REDIS_PORT=6379
REDIS_VOLUME_NAME=life-buy-agent-redis-data

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_VOLUME_NAME=life-buy-agent-minio-data
